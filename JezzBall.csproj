<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>JezzBall</AssemblyName>
    <RootNamespace>JezzBall</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\sounds\*.WAV" Link="sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
